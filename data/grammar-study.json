  "exercises": [
    {
      "prompt": "昨日、図書館で本を（　）。",
      "romaji": "Kinou, toshokan de hon o (   ).",
      "spanish": "Ayer leí un libro en la biblioteca.",
      "options": [
        "読みます",
        "読みました",
        "読みません"
      ],
      "answer": 1,
      "explanation": "昨日 (kinou, ayer) exige pasado. La acción ocurrió, por eso se usa el pasado afirmativo 読みました (yomimashita)."
    },
    {
      "prompt": "日曜日は仕事を（　）。",
      "romaji": "Nichiyoubi wa shigoto o (   ).",
      "spanish": "El domingo no trabajaré.",
      "options": [
        "します",
        "しません",
        "しました"
      ],
      "answer": 1,
      "explanation": "La oración niega una acción presente o futura. La forma cortés negativa de します es しません (shimasen)."
    },
    {
